BA_ "CycleTime" BO_ 6 1000;
BA_ "CycleTime" BO_ 7 1000;
BA_ "CycleTime" BO_ 8 1000;
BA_ "CycleTime" BO_ 9 1000;
BA_ "CycleTime" BO_ 10 200;
BA_ "CycleTime" BO_ 11 200;
BA_ "CycleTime" BO_ 12 200;
BA_ "CycleTime" BO_ 13 200;
BA_ "CycleTime" BO_ 14 200;
BA_ "CycleTime" BO_ 15 200;
BA_ "CycleTime" BO_ 16 200;
BA_ "CycleTime" BO_ 17 200;
BA_ "CycleTime" BO_ 27 33;
BA_ "CycleTime" BO_ 28 33;
BA_ "CycleTime" BO_ 29 33;
BA_ "CycleTime" BO_ 48 500;
BA_ "CycleTime" BO_ 49 500;
BA_ "CycleTime" BO_ 50 2000;
BA_ "CycleTime" BO_ 31 2000;
BA_ "CycleTime" BO_ 35 33;
BA_ "CycleTime" BO_ 36 33;
BA_ "CycleTime" BO_ 44 33;
