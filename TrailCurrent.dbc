VAL_ 9 LatitudeSign 0 "North_Positive" 1 "South_Negative";
VAL_ 9 LongitudeSign 0 "East_Positive" 1 "West_Negative";
VAL_ 24 ButtonOrCommand 0 "Toggle_Output1" 1 "Toggle_Output2" 2 "Toggle_Output3" 3 "Toggle_Output4" 4 "Toggle_Output5" 5 "Toggle_Output6" 6 "Toggle_Output7" 7 "Toggle_Output8" 8 "All_Channels_Command" 9 "All_Channels_On";
VAL_ 51 SequenceType 0 "Interior_FadeAndChase" 1 "Exterior_FadeAndFlash";
VAL_ 52 SequenceType 0 "Interior_FadeAndChase" 1 "Exterior_FadeAndFlash";
VAL_ 53 SequenceType 0 "Interior_FadeAndChase" 1 "Exterior_FadeAndFlash";
VAL_ 35 IsCurrentNegative 0 "Charging_Positive" 1 "Discharging_Negative";
VAL_ 36 IsWattageNegative 0 "Charging_Positive" 255 "Discharging_Negative";
VAL_ 44 SolarChargeStatus 0 "Off" 2 "Fault" 3 "Bulk_Charging" 4 "Absorption_Charging" 5 "Float_Charging";
VAL_ 45 IsPanelCurrentNegative 0 "Normal_Positive" 1 "Reverse_Negative";
VAL_ 46 LoadState 0 "Off" 1 "On" 4 "Default";
VAL_ 32 ConfigCommand 1 "Set_Vehicle_Config" 2 "Request_Status" 3 "Zero_Tare";
VAL_ 32 MountingSurface 0 "Floor" 1 "Left_Wall" 2 "Right_Wall";
VAL_ 50 MountingOrientation 0 "Floor" 1 "Left_Wall" 2 "Right_Wall";
